<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game-free test suite. Runs on any OS with the .NET SDK: no Steam, no game install. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WinterMP.Core.Tests</AssemblyName>
    <RootNamespace>WinterMP.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinterMP.Core\WinterMP.Core.csproj" />
  </ItemGroup>

</Project>
